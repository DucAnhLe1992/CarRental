PORT=3000
# Runtime application connection (use the pooled endpoint on Neon).
DATABASE_URL=postgresql://username:password@pooled-host/database
# Drizzle migrations (use the direct endpoint; may equal DATABASE_URL locally).
DATABASE_DIRECT_URL=postgresql://username:password@direct-host/database
# Set to false for a local Postgres without TLS.
# DATABASE_SSL=false
JWT_SECRET=pick-any-long-random-string-here
FRONTEND_ORIGIN=http://localhost:5173

# Failed login/register attempts allowed per IP per 15 minutes.
# AUTH_RATE_LIMIT_MAX=10
# Number of reverse proxies in front of the API (e.g. 1 on Render/Fly/Heroku).
# TRUST_PROXY=0

# Stripe — use a restricted test key (rk_test_...)
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
